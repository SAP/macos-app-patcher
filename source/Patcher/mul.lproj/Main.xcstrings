    "bCf-4Y-BlK.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"If you prefer not to install updates automatically, but would like to be notified when new updates are available, use the slider below to set the notification interval (in hours).\"; ObjectID = \"bCf-4Y-BlK\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Du Updates nicht automatisch installieren möchtest, aber benachrichtigt werden willst, sobald neue Updates verfügbar sind, stelle bitte mit dem unten stehenden Schieberegler ein, in welchem Abstand (in Stunden) Du Benachrichtigungen erhalten willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you prefer not to install updates automatically, but would like to be notified when new updates are available, use the slider below to set the notification interval (in hours)."
          }
        }
      }
    },
