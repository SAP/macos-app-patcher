    "MTD-UF-jMQ.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"If you would like to defer the display and installation of new updates for a certain number of days, use the slider below to select the number of days you would like to defer the updates from the release date.\"; ObjectID = \"MTD-UF-jMQ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Du die Anzeige oder Installation neuer Updates um eine bestimmte Anzahl von Tagen verzögern möchtest, stelle bitte mit dem unten stehenden Schieberegler ein, um wieviele Tage ab dem Datum der Veröffentlichung, Du Updates verzögern möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you would like to defer the display and installation of new updates for a certain number of days, use the slider below to select the number of days you would like to defer the updates from the release date."
