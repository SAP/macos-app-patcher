    "5oJ-01-Bka.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This application has a Discover section in its sidebar by default. This section lets you easily find and install all of our apps. It also allows you to reinstall apps you have already installed. If you are not interested in this feature, please select the option below.\"; ObjectID = \"5oJ-01-Bka\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Programm verfügt standardmäßig über einen „Entdecken“-Bereich in der Seitenleiste. In diesem Bereich kannst Du alle unsere Apps ganz einfach finden und installieren. Außerdem kannst Du dort bereits installierte Apps erneut installieren. Wenn Du an dieser Funktion nicht interessiert bist, aktiviere bitte die unten stehende Option."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This application has a Discover section in its sidebar by default. This section lets you easily find and install all of our apps. It also allows you to reinstall apps you have already installed. If you are not interested in this feature, please select the option below."
          }
        }
      }
    },
