    "edS-Oh-xY4.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This program was developed to automatically update all of the apps we offer. Ideally, this happens in the background without you noticing. You should always assume that your apps are up to date. However, if you would like more control over the update process, please select the update strategy that works best for you from the menu below.\"; ObjectID = \"edS-Oh-xY4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Programm wurde entwickelt, um alle von uns angebotenen Apps automatisch zu aktualisieren. Im Idealfall geschieht dies im Hintergrund, ohne dass Du es bemerkst. Du solltest stets davon ausgehen können, dass Deine Apps auf dem neuesten Stand sind. Wenn Du jedoch mehr Kontrolle über den Aktualisierungsprozess haben möchtest, wähle bitte aus dem unten stehenden Menü die für Dich am besten geeignete Updatestrategie aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This program was developed to automatically update all of the apps we offer. Ideally, this happens in the background without you noticing. You should always assume that your apps are up to date. However, if you would like more control over the update process, please select the update strategy that works best for you from the menu below."
          }
        }
      }
    },
