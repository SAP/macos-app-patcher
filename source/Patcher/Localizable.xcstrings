    "VersionInfoString" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$(currentVersion)@ wurde am %2$(releaseDate)@ veröffentlicht, aber Du hast auf Deinem Mac noch Version %3$(installedVersion)@ installiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$(currentVersion)@ was released on %2$(releaseDate)@, but you still have version %3$(installedVersion)@ installed on your Mac."
