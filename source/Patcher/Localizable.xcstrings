    },
    "SelfUpdateWarningText" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patcher wird geschlossen, um das Update zu installieren. Sobald das Update abgeschlossen ist, wird Patcher automatisch neu gestartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Patcher application will close in order to install the update. After the update finishes, the application will restart automatically."
          }
        }
      }
    },
    "SelfUpdateWarningTitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist Du sicher, dass Du ein Update für Patcher durchführen willst?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to update Patcher?"
          }
        }
      }
    },
