{
  "sourceLanguage" : "en",
  "strings" : {
    "ApplicationsLoadFailedErrorText" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Update-Informationen konnten nicht geladen werden. Bitte überprüfe Deine Internetverbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The update information could not be loaded. Please check your internet connection and try again."
          }
        }
      }
    },
    "ApplicationsLoadFailedErrorTitle" : {
      "localizations" : {
