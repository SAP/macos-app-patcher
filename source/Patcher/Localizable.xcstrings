    "InstallationFailedErrorText" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Installation von %(appName)@ ist ein Fehler aufgetreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An error occurred while installing %1$(appName)@."
          }
